    m_HorizontalOverflow: 1
    m_VerticalOverflow: 1
    m_LineSpacing: 1
  m_Text: "\uD604\uC7AC \uC2DC\uAC01\uACFC \uBAA8\uB450\uAC00 \uACF5\uC720\uD558\uB294
    \uAD00\uCE21 \uC9C0\uC810\uC5D0 \uB9DE\uCD98\n\uBCC4\uD558\uB298\uACFC \uB2EC\uC744
    \uBC14\uB77C\uBCF4\uB294 \uC870\uC6A9\uD55C \uCD08\uC6D0\uC785\uB2C8\uB2E4.\n\n\uB9E4
    \uC815\uAC01\uC5D0 \uC720\uC131 \uC774\uBCA4\uD2B8\uAC00 \uC2DC\uC791\uB429\uB2C8\uB2E4.\n\uD65C\uB3D9
    \uC911\uC778 \uACC4\uC808 \uC720\uC131\uC6B0\uAC00 \uC788\uC73C\uBA74 \uC720\uC131\uC6B0\uAC00
    \uB098\uD0C0\uB098\uBA70,\n\uADF8 \uC678\uC5D0\uB294 \uC0B0\uBC1C \uC720\uC131\uC774
    \uD558\uB298\uC744 \uAC00\uB85C\uC9C0\uB985\uB2C8\uB2E4.\n\n\uD734\uC2DD, \uB300\uD654,
    VR \uC218\uBA74, \uC601\uC0C1 \uAC10\uC0C1, \uADF8\uB9BC, \uC0AC\uC9C4 \uCD2C\uC601\uC744
    \uC990\uACA8 \uC8FC\uC138\uC694.\nPC / Android / iOS \uC9C0\uC6D0"
